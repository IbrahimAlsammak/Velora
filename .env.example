# ============================================================================
# Copy this file to ".env" (same folder) and fill in your own values.
# .env holds passwords - it is NEVER uploaded to GitHub (see .gitignore).
# ============================================================================

# Where the shop lives:
#   on your laptop (test):  SITE_ADDRESS=:80                 PUBLIC_URL=http://localhost
#   on the server:          SITE_ADDRESS=veloramodest.com, www.veloramodest.com
#                           PUBLIC_URL=https://veloramodest.com
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost

# Database passwords - make up two long random passwords (letters + numbers, no spaces)
MYSQL_PASSWORD=change-me-long-random-1
MYSQL_ROOT_PASSWORD=change-me-long-random-2

# Login token signing key - a long random base64 text.
# Make one with:  openssl rand -base64 48
JWT_SECRET=change-me

# Admin account (used on the first start; later changes in the admin panel are kept)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-at-least-10-characters
ADMIN_NAME=Ibrahim

# Telegram new-order messages (leave empty to switch off)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
