# Caddy web server settings.
# SITE_ADDRESS comes from the .env file:
#   on your laptop:  :80                                    -> http://localhost
#   on the server:   modestbyvelora.com, www.modestbyvelora.com  -> https with a free certificate
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Backend: data (/api) and product photos (/uploads)
	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /uploads/* {
		reverse_proxy backend:8080
	}

	# Everything else = the React website (unknown addresses show index.html, React Router handles them)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Website files with a fingerprint in their name never change -> browsers may keep them for a year
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	# Basic safety headers
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
}
